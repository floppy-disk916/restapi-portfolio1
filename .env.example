DATABASE_URL="database+driver://username:pass@host/db"

PUBLIC_KEY=<for-rs256-and-alike>
PRIVATE_KEY=<for-rs256-and-alike>
SECRET_KEY=<for-hs256-and-alike>
JWT_ALGO=<comma-separated-quoted-string>
JWT_EXPIRE_MIN=<integer>

API_KEY_EXPIRE_DAY=<integer>
OPENAPI_URL="/openapi.json"

#
# Command to generate secret key = "openssl rand -hex <length>"
# 
# Command to generate rs256 private key = "openssl genrsa <length>"
#
# Command to generate rs256 public key from a private key file = 
# "openssl rsa -in <private-key>.pem -pubout -out <public-key>.pem"
#
