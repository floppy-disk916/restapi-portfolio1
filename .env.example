DATABASE_URL="driver://user:pass@host/db"
REDIS_URL="redis://host"

#All these are used for access token

#
# To get a private key, run "openssl genrsa -out private.pem <total_bytes>"
#
# To get a public key derived from the private one, 
# run "openssl rsa -in private.pem -pubout -out public.pem"
#
# To get a secret key, run "openssl rand -hex 32"
#

PRIVATE_KEY=<your_private_key>
PUBLIC_KEY=<your_public_key>

#intended for hs256 jwt algorithm
SECRET_KEY=<your_secret_key>

#write it as a sequence of quoted string separated by commas
JWT_ALGO=<your_algorithms>
JWT_EXPIRE_MIN=<your_expire_min>
